  /// Populated ONLY when lotNoRaw is an unambiguous single integer under 1000 (every real single Lot
  /// number in this dataset is 1-454 at Bouaké / 1-256 at Yamoussoukro; the 11 ambiguous concatenated
  /// values are all >= 246253, nowhere near that range — a wide, deliberately conservative cutoff,
  /// not a guessed split point).
  lotNo    String?

  whReceiptNoRaw      String?
  ficheNoRaw          String?
  originRaw           String?
  supplierNameRaw     String?
  supplierCodeRaw     String?
  ccakSupplierCodeRaw String?
  status              String?
  dryType             String?
  destinationRaw      String?

  issuedGrossWithBagsPalletsKg   Decimal?
  issuedPalletWeightKg           Decimal?
  issuedGrossWithBagsKg          Decimal?
  issuedBags                     Int?
  issuedNetWeightKg              Decimal?
  receivedGrossWithBagsPalletsKg Decimal?
  receivedPalletWeightKg         Decimal?
  receivedGrossWithBagsKg        Decimal?
  receivedBags                   Int?
  receivedNetWeightKg            Decimal?

  inputMoisturePct  Decimal?
  inputNutCount     Decimal?
  inputKor          Decimal?
  outputMoisturePct Decimal?
  outputNutCount    Decimal?
  outputKor         Decimal?

  oil        Decimal?
  rejection  Decimal?
  goodKernel Decimal?
  immature   Decimal?
  spotted    Decimal?
  shell      Decimal?
  void       Decimal?

  moistureLossPct Decimal?
  dryingLossKg    Decimal?
  dryingLossPct   Decimal?
  triageLossKg    Decimal?
  triageLossPct   Decimal?
  damagedNutsKg   Decimal?

  inputBagsForDrying                 Int?
  outputBagsAfterDrying              Int?
  dryingOrPicking                    String?
  remarks                            String?
  issuedToProduction                 String?
  reDryingDate                       DateTime?
  reDryingDateRaw                    String?
  moistureFirstRedryPct              Decimal?
  moistureSecondDryPct               Decimal?
  issuedToProduction3                String?
  remarks4                           String?
  /// The sheet's OWN flag column, kept verbatim for comparison — it does not perfectly agree with
  /// this importer's own lotNoRaw-based ambiguity detection (e.g. one BIN-code contamination row is
  /// flagged "YES" here, and one 6-digit concatenated row is NOT), which is itself worth keeping
  /// visible rather than silently reconciling the two into one answer.
  needsLotAllocationClarificationRaw String?

  /// In-app sun drying (Oct 2026): a Lot is dried in rounds. Round 1 is the first issue; a quality check that sends the Lot back
  /// opens the next round, which points at the first through firstBatchId. Status: IN DRYING → QUALITY CHECK → PASSED | RE-DRY
  /// (contract domain/sunDrying.ts). Imported workbook rows leave all of these null.
  round             Int?
  firstBatchId      String?
  /// The drying sample's cut test (grams of a 1000 g sample) before the round and after it. The QFS reception sample is a
  /// separate measurement and is never copied here.
  inputGoodKernelG  Decimal?
  inputImmatureG    Decimal?
  inputSpottedG     Decimal?
  inputRejectionG   Decimal?
  inputVoidG        Decimal?
  inputOilG         Decimal?
  inputShellG       Decimal?
  outputGoodKernelG Decimal?
  outputImmatureG   Decimal?
  outputSpottedG    Decimal?
  outputRejectionG  Decimal?
  outputVoidG       Decimal?
  outputOilG        Decimal?
