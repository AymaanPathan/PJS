/// Unit-warehouse dispatch OUT — sheet "CHARGEMENT" of "Dispatch RCN from Bouake Warehouse
/// Report.xlsx", header row 4, data from row 5. Measured on the real file: 544 data LINES (gated on
/// "any of columns 1-41 non-blank" — never on S.No alone, since 120 of the 544 lines are
/// CONTINUATION lines with no S.No at all, only a repeat of the voyage's own VYOGE NUMBER plus one
/// more source bin's own bag count/weight). One dispatch ("voyage") can draw from several bins, so
/// this is a PARENT/LINE shape: one flat table, one row per line, grouped by vyogeNumber — 413
/// distinct values across 504 lines that carry one (40 lines have none at all).
///
/// Surrogate `id`, deliberately NOT `sn` (10 duplicate S.No values in the real data — e.g. 366, 368,
/// 369 each appear twice) and NOT `vyogeNumber` (40 lines lack one, and even where present it's
/// shared by every line of one voyage, not a per-line key). Idempotent re-commit instead keys off
/// `(source, sheetRow)` — the physical row a re-upload of the SAME file always reproduces, which a
/// synthetic uuid never would.
model WarehouseDispatchLine {
  id String @id @default(uuid())

  /// The sheet's own S.No — present on 424/544 lines, duplicated on 10 of those, ABSENT on the 120
  /// continuation lines. Not a key; see the model comment above.
  sn Int?

  chargeDate     DateTime?
  chargeDateRaw  String?
  warehouseSite  String?
  /// The voyage/trip number this line belongs to — see the model comment. Nullable: 40/544 lines
  /// carry none, and a blank one is still a real line (never skipped).
  vyogeNumber    String?
  /// The voyage number exactly as the workbook wrote it ("BKT001" / "BKT-414"). vyogeNumber holds
  /// the system format (BKT-2026-001) since the Oct 2026 ID standardisation.
  vyogeNumberRaw String?
  remark         String?
  scaleLocation  String?
  /// The STORE (BKE-001/002/003), same level as WarehouseDischarge.warehouse — not upserted as a
  /// site by this importer (see upsertObservedStores in services/imports.ts).
  warehouse      String?
  whOrDirect     String?
  bin            String?
  origin         String?
  truckNo        String?
  transporter    String?
  driver         String?
  /// Kept as text (not Int) — a phone number is an identifier, not a quantity, and this column
  /// never appears anywhere else in this schema as anything else.
  phone          String?
  whReceiptNo    String?
  /// Bridges back to a Receipt the same way WarehouseDischarge.ficheCca does, but NOT required
  /// here (unlike that model) — 0/544 lines are skipped for lacking one; this importer does no
  /// receipt-stage write-back at all, so there is nothing that needs the bridge to be non-null.
  ficheCca       String?

  /// This LINE's own contribution — on a continuation line these three describe just that line's
  /// bin, not the whole voyage's total (the sheet never labels which row, if any, is "the total").
  binwiseLoadedBags Int?
  totalBags         Int?
  grossWt           Decimal?
  netWeight         Decimal?

  status          String?
  unloadingStatus String?

  /// One quality panel (unlike WarehouseDischarge's two) — same 16 labels as
  /// WarehouseDischarge.sampling/finalOffload, flat here since CHARGEMENT only has the one.
  browns             Decimal?
  voids              Decimal?
  oil                Decimal?
  totDefect          Decimal?
  goodKernel         Decimal?
  immature           Decimal?
  spotted            Decimal?
  totKernels         Decimal?
  kor                Decimal?
