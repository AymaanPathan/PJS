// ANAGROCI RCN procurement — Postgres schema.
//
// Design notes that matter when reading this file:
//
// 1. STAGE DATA IS FULLY NORMALIZED. There is no `stageData` JSON column. Each of the 16 stages in
//    @anagroci/contract's stages.ts has its own table, with one column per field. Column names come
//    from `StageField.col` and are generated by packages/contract/scripts/gen-prisma-models.ts;
//    tests/stageMap.schema.test.ts asserts every (model, col) here exists in the Prisma DMMF, so a
//    field added to stages.ts without a migration fails CI rather than silently dropping writes.
//
// 2. EVERY STAGE COLUMN IS `String?`. ReceiptRecord.stageData is Record<string, Record<string,
//    string>> — every value is a string on the wire. Typing these as Decimal breaks round-trip two
//    ways: "9.50" comes back "9.5", and "" vs "0" collapse (8 seeded receipts have NET WT KGS = "").
//    The source workbooks also carry French decimal commas ('44,94'). Typed *Num shadow columns
//    exist alongside, written in the same transaction, for reporting and data-quality checks only.
//
// 3. PRESENCE IS AN EXPLICIT FACT (StageEntry), not "a payload row exists". deriveStatus() tests
//    the presence of stageData[stageId], and the frontend's per-keystroke writes mean a stage can
//    legitimately exist with every field blank. StageEntry reproduces that exactly — including that
//    quirk — so the migration is behaviour-preserving. The quirk is then reported as a
//    `stage_present_but_empty` finding instead of being silently changed.
//
// 4. FK POLICY IS SPLIT, on purpose. Hard FKs only on edges verified 100% clean against the real
//    seed data. Bin, Lot and ledger-4 Origin are deliberately NOT hard-FK'd: the workbooks use
//    disjoint namespaces for two different physical sites (Bouaké's BKE-00x vs Yakro's BIN-0xx /
//    ANAGROCI-01), and hard-FKing them would mean inventing a mapping or dropping real rows. They
//    are strings plus a nullable resolved id, with orphans reported by /api/data-quality.
//
// 5. NO `Lot` ENTITY YET. The receipts' LOT-2026NNNN values are fabricated by tools/extract-seed.py
//    and share zero keys with the drying jobs or ledger 4. Building an entity on invented keys
//    would bake in a guess; lot uniqueness lives as a partial unique index on the n-lot stage row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Masters ───────────────────────────────────────────────────────────────
// Seeded as the union of everything observed in the workbooks, annotated with provenance — not a
// curated whitelist. Dropping an unmatched row would be discarding real client data.

model Supplier {
  code         String  @id
  /// Stored without the leading "RCN" the workbooks carry (contract domain/supplierCode.ts).
  name         String
  /// The name exactly as the source had it, kept only when "RCN" was dropped, so a workbook that still
  /// says "RCN SCOOPS DIENE" can be matched and the change can be undone.
  formerName   String?
  /// Where this code was first observed, e.g. "seed/suppliers.json" or a workbook name.
  source       String?
  /// The permanent system ID (SUP-0001). Issued by the database from a sequence, so every writer — the app, the
  /// seeder, an Excel upload — gets one without knowing about it, and it never changes even if the LBA code does.
  supplierNo   String  @unique @default(dbgenerated("('SUP-'::text || lpad((nextval('supplier_no_seq'::regclass))::text, 4, '0'::text))"))
  /// "active" | "inactive" | "suspended" (contract domain/supplierProfile.ts). Inactive suppliers leave the pickers;
  /// suspended ones stay, with a warning. A supplier already used by trucks, plans or jute movements is made inactive
  /// rather than deleted, so its history stays whole.
  status       String  @default("active")
  statusReason String?

  // The LBA register (client's Oct 2026 table). Which are required lives in contract domain/supplierProfile.ts.
  tradeName         String?
  zone              String?
  region            String?
  managerName       String?
  managerPosition   String?
  phonePrimary      String?
  phoneSecondary    String?
  email             String?
  address           String?
  registrationRef   String?
  /// Bank details: only the supplier page shows them (admin / Warehouse Incharge); the supplier list never carries them.
  bankAccountHolder String?
  bankName          String?
  bankAccountRef    String?
  /// "sample" when the register details were filled with demo values rather than given by the client, so they are
  /// never mistaken for real ones. Cleared as soon as someone saves the supplier's details by hand.
  detailsSource     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  createdBy   User?    @relation("SupplierCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("SupplierUpdater", fields: [updatedById], references: [id])

  juteMovements JuteWarehouseMovement[]
}

/// Site -> Store -> Bin is the real hierarchy (BOUAKE -> BKE-002 -> BKE-002-BIN-026), confirmed by
/// the client's own sheets placing a "Warehouse/Site" column next to a "Warehouse" column that
/// actually holds a store code. This one table holds both levels via a self-relation rather than a
/// second table, because 4 hard FKs already point at Warehouse.name and they point at DIFFERENT
/// levels (Receipt.warehouse holds a site; WarehouseDischarge.warehouse holds a store) — a new
/// table would force repointing an FK under it. COALESCE(site, name) is the site-scoping expression
/// everywhere a query needs "which site does this row ultimately belong to".
model Warehouse {
  name   String  @id
  source String?

  /// The client's own typology ("Village/Regional/Factory" — see warehouseKinds.ts), set ONLY on
  /// SITE rows (site IS NULL). Nullable + reported, never defaulted: a guessed classification is
  /// indistinguishable from a real one, same discipline as WarehouseAlias.provenance below.
  kind String?

  /// The app's operational tier ("UNIT" | "CENTRAL" — see contract's warehouseTypes.ts), set ONLY on
  /// SITE rows. Separate from `kind`: kind is the client's own vocabulary, type decides which
  /// section of the app the warehouse belongs to and which users can be assigned to it. Nullable and
  /// never defaulted, same discipline as `kind`.
  type String?

  /// The code embedded in every system ID issued at this warehouse (REC-/LOT-/DP-<code>-<year>-NNN,
  /// contract's domain/ids.ts). Set from the master by an admin, never derived from the name: the
  /// the client's workbook gives BOUAKE = BKE, YAKRO FACTORY = YAK; anything else is NULL until someone enters it, and a warehouse with
  /// no code refuses to issue an ID rather than issuing a guessed one.
  code String? @unique

  /// NULL means this row IS a site. Non-null means this row is a STORE belonging to that site.
  site    String?
  siteRef Warehouse?  @relation("WarehouseSite", fields: [site], references: [name])
  stores  Warehouse[] @relation("WarehouseSite")

  receipts          Receipt[]
  deliveryPlans     DeliveryPlan[]                 @relation("DeliveryPlanSite")
  planStores        DeliveryPlan[]                 @relation("DeliveryPlanStore")
  transfersFrom     TransferRequest[]              @relation("TransferRequestFrom")
  transfersTo       TransferRequest[]              @relation("TransferRequestTo")
  dryingJobs        DryingJob[]
  juteMovements     JuteWarehouseMovement[]
  emptyBagsSent     JuteEmptyBagReceipt[]
  transfersOut      JuteWarehouseTransferReceipt[] @relation("TransferSource")
  transfersIn       JuteWarehouseTransferReceipt[] @relation("TransferDestination")
  aliases           WarehouseAlias[]
  users             User[]
  productionBatches ProductionBatch[]
  truckMovements    TruckMovement[]
  boilerReadings    BoilerReading[]

  @@index([kind])
  @@index([type])
  @@index([site])
}

/// Bin.warehouseName stays NULL where the source data doesn't say — the real workbooks never map
/// bin -> warehouse, and inventing that mapping is exactly what ground rule §4 forbids.
model Bin {
  code          String               @id
  /// The store (a warehouse row with a site) the Bin is in. NULL on Bins that came from the workbooks, which never said.
  warehouseName String?
  source        String?
  /// When the Bin was created in the app. NULL = it was already there (imported); no date is invented for those.
  createdAt     DateTime?
  batchBins     ProductionBatchBin[]
}

model Origin {
  name      String    @id
  source    String?
  /// When the Origin was added in the app (Masters › Origins). NULL = observed in a workbook; no date is invented for those.
  createdAt DateTime?
  receipts  Receipt[]
}

/// One workbook calls the Yakro factory warehouse "ANAGROCI-01". That is an inference (from the
/// file name "Drying Report_Factory warehouse.xlsx" and the sheet "FINAL DRY RCN-YAKRO-2026"),
/// NOT something the client stated — so it is recorded with provenance and surfaced by
/// /api/data-quality for confirmation, never applied silently.
model WarehouseAlias {
  alias         String    @id
  warehouseName String
  warehouse     Warehouse @relation(fields: [warehouseName], references: [name])
  source        String
  /// "stated" | "inferred" | "stated-in-source" — "inferred" aliases (guessed from a filename/sheet
  /// name) are reported for client confirmation by warehouse_alias_inferred. "stated-in-source" is
  /// a real upgrade path: a later workbook can place the same alias next to its target warehouse in
  /// an actual column, at which point the alias is re-recorded with this provenance and the finding
  /// naturally closes — this is not the same as deleting the question, the alias row stays.
  provenance    String
}

// ── Core entity ───────────────────────────────────────────────────────────
// One truck = one Receipt = one Lot, always (confirmed client rule). Note there are no lotNo /
// binNo columns here: they live on the n-lot / n-bin stage rows and are projected onto the wire
// shape by the assembler. Keeping a second copy here is what forced the old stage-field sync block.

model Receipt {
  /// REC-<warehouse code>-<arrival year>-NNNN (contract's domain/ids.ts), issued once and never changed.
  id     String @id
  source String /// "imported" | "entered"

  /// The REC-2026-NNNN id this receipt had before system IDs were standardised (Oct 2026), so old
  /// links, exports and bookmarks still resolve. NULL on every receipt created after the change.
  legacyId String? @unique

  /// The plan this truck arrived against, if any — unplanned trucks are allowed. The plan's actual
  /// arrival date, truck and delivery status are read from here, never stored on the plan.
  deliveryPlanId       String?
  deliveryPlan         DeliveryPlan? @relation(fields: [deliveryPlanId], references: [id])
  /// Set only when the plan was attached AFTER the receipt existed (a truck that arrived unplanned and
  /// was regularised later). NULL on a truck that arrived against its plan — that is how the two differ.
  deliveryPlanLinkedAt DateTime?

  /// One recorded decision that an unplanned / off-plan truck is accepted as an exception. Whether a
  /// truck NEEDS one is derived (contract's domain/deliveryPlan.ts), never stored. Approval never
  /// blocks the reception itself.
  exceptionApprovedAt DateTime?
  exceptionApprovedBy String?
  exceptionApprover   User?         @relation("ExceptionApprover", fields: [exceptionApprovedBy], references: [id])
  uploadIssues        UploadIssue[]
  exceptionNote       String?

  arrivalDate  String
  supplierName String
  lbaCode      String
  vehicleNo    String

  warehouse    String
  warehouseRef Warehouse @relation(fields: [warehouse], references: [name])
  origin       String?
  originRef    Origin?   @relation(fields: [origin], references: [name])

  /// Read-only shadow of the pre-normalization JSON, kept for exactly one release so the
  /// round-trip tests have a live oracle and a rollback path. Dropped in the Phase 8 migration.
  stageDataShadow String?

  /// Locked when the GRN is complete (contract domain/recordLock.ts); cleared by an Admin's reopen, which leaves its
  /// reason on the timeline. NULL = open, including every record that existed before locking did.
  lockedAt   DateTime?
  lockedById String?
  locker     User?     @relation("ReceiptLocker", fields: [lockedById], references: [id])

  stageEntries  StageEntry[]
  branches      ReceiptBranch[]
  timeline      TimelineEntry[]
  submissions   FormSubmission[]
  fieldChanges  StageFieldChange[]
  transferLines TransferRequestLine[]

  gate            StageGateEntry?
  verify          StageVerifyDocs?
  qfs             StageQualityQfs?
  gross           StageGrossWeight?
  lot             StageLotAssignment?
  bin             StageBinAllocation?
  unload          StageUnload?
  netwt           StageNetWeight?
  grn             StageGrn?
  stock           StageStockUpdate?
  drying          StageDryingDecision?
  otherActivities OtherActivity[]
  activityLedger  ActivityLedgerEntry[]
  xferdec         StageTransferDecision?
  reject          StageRejection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouse])
  @@index([supplierName])
  @@index([arrivalDate])
  /// Backs the excel-import dedup heuristic (vehicleNo + arrivalDate + supplierName) — the
  /// receipts importer has no natural unique key from the source sheet, so this triple is checked
  /// on every uploaded row and needs to not be a table scan.
  @@index([vehicleNo])
  @@index([deliveryPlanId])
}

/// Expected arrivals, captured before the truck comes (Oct 2026 team feedback). Columns are the
/// client's own "Delivery Plan" sheet (APPLICATION VIEW workbook), minus everything that describes
/// what actually happened (actual received, arrivals, accepted trucks, remaining, variance, status,
/// truck no) — those are derived from the linked Receipts (contract's domain/deliveryPlan.ts), so a
/// plan can never disagree with the trucks that arrived. Cancelling is the only stored state: it is a
/// person's decision, not something the arrivals can tell.
///
/// plannedDeliveryDate = the sheet's "Planning Date"; expectedArrivalDate = "Expected Delivery Start".
model DeliveryPlan {
  /// DP-<destination warehouse code>-<expected arrival year>-NNN
  id                   String     @id
  plannedDeliveryDate  String?
  supplierName         String
  supplierCode         String?
  expectedQuantityKg   Decimal?
  expectedTruckType    String?
  expectedArrivalDate  String
  expectedDeliveryEnd  String?
  expectedTrucks       Int?
  expectedOrigin       String?
  /// Purchase / funding reference, when the client has one. The 2026 source has none ("Not available
  /// in 2026 source"), so this is NULL rather than a placeholder.
  fundingReference     String?
  destinationWarehouse String
  warehouseRef         Warehouse  @relation("DeliveryPlanSite", fields: [destinationWarehouse], references: [name])
  /// The store inside the destination site where the goods are expected (BKE-003). A truck that goes
  /// to a different store is a "warehouse change" exception, so this has to be able to be recorded.
  destinationStore     String?
  storeRef             Warehouse? @relation("DeliveryPlanStore", fields: [destinationStore], references: [name])
  remarks              String?
  /// Where the plan came from when it was not a real pre-alert (the client's 2026 plans were rebuilt
  /// from actual receipts). Kept verbatim so reconstructed data is never mistaken for real pre-alerts.
  planningBasis        String?
  cancelledAt          DateTime?
  cancelledBy          String?
  canceller            User?      @relation("PlanCanceller", fields: [cancelledBy], references: [id])
  cancelReason         String?
  receipts             Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationWarehouse, expectedArrivalDate])
}

/// A request to move Lots from one warehouse to another (Oct 2026 team feedback: "Transfer Request →
/// BKT Transfer ID"). Minimal on purpose: which Lots, from where, to where, and how far it got.
model TransferRequest {
  /// BKT-<transfer year>-NNN — continues the 2026 dispatch sheet's own BKT001 / BKT-414 numbering.
  id            String                @id
  transferDate  String
  fromWarehouse String
  fromRef       Warehouse             @relation("TransferRequestFrom", fields: [fromWarehouse], references: [name])
  toWarehouse   String
  toRef         Warehouse             @relation("TransferRequestTo", fields: [toWarehouse], references: [name])
  /// The store chosen at the destination. `toWarehouse` stays its SITE, because that is what decides who
  /// sees the BKT and who records its arrival. Null on BKTs created before a store could be chosen.
  toStore       String?
  /// "requested" | "dispatched" | "received" — the STEP. What a person reads (in transit / closed /
  /// discrepancy) is derived with the variance (contract's domain/transfers.ts), never stored.
  status        String                @default("requested")
  remarks       String?
  lines         TransferRequestLine[]

  /// One BKT is one truck / voyage (client, Oct 2026): the truck is on the header, and a truck loading
  /// from several Bins is several LINES under the one BKT. The workbook's own 2026 data breaks this in
  /// places (one voyage on two trucks); that is reported by the audit, not corrected.
  truckNo             String?
  transporter         String?
  driver              String?
  driverPhone         String?
  /// What leaves Bouaké: the loaded truck's weight at the dispatch scale (RCN + bags).
  dispatchedGrossKg   Decimal?
  /// The warehouse receipt number the dispatch is recorded against, and the one the receiving warehouse records on arrival.
  dispatchWhReceiptNo String?
  receiveWhReceiptNo  String?
  dispatchedAt        DateTime?
  dispatchedBy        String?
  dispatcher          User?     @relation("TransferDispatcher", fields: [dispatchedBy], references: [id])

  /// What arrives — entered by the RECEIVING warehouse only, on arrival, and blank until then. Nothing
  /// here is pre-filled at dispatch: the variance is the comparison between the two sides.
  bagsReceived     Int?
  damagedBags      Int?
  receivedGrossKg  Decimal?
  korReceived      Decimal?
  moistureReceived Decimal?
  nutCountReceived Int?
  receivedComment  String?
  /// The receiving warehouse's own Lot number for it, exactly as they wrote it. One lot number has been
  /// seen on two different BKTs, so this is a record of what they said, not a key.
  receivedLotNoRaw String?
  receivedAt       DateTime?
  receivedBy       String?
  receiver         User?     @relation("TransferReceiver", fields: [receivedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromWarehouse])
  @@index([toWarehouse])
  @@index([truckNo])
}

/// One Lot on a transfer. The Lot, supplier and fiche are read from the receipt, not retyped; bags
/// and weight are what is actually sent, which can be less than the whole Lot.
model TransferRequestLine {
  id              Int             @id @default(autoincrement())
  transferId      String
  transfer        TransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  receiptId       String
  receipt         Receipt         @relation(fields: [receiptId], references: [id])
  bags            Int?
  netWeightKg     Decimal?
  /// Quality of this Lot as dispatched (client review, Oct 2026). Defaults to the Lot's own quality check and can be
  /// re-measured at dispatch; required to dispatch.
  moisture        Decimal?
  kor             Decimal?
  nutCount        Int?
  /// Where the Lot was loaded from — its Bin(s) when it was added. A record, so a BKT that loads one
  /// truck from several Bins shows them all.
  binCode         String?
  /// The RECEIVING site's bin the Lot was unloaded into ("BIN NO." on the client's Bouake RCN Receiving at
  /// Factory sheet). Entered on arrival only; it is what puts the Lot in that site's bin stock for production.
  receivedBinCode String?

  @@unique([transferId, receiptId])
  @@index([receiptId])
}

/// The single source of truth for "has this receipt reached this stage?" — the only thing
/// deriveStatus() reads. See header note 3.
model StageEntry {
  receiptId String
  stageId   String
  startedAt DateTime @default(now())
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@id([receiptId, stageId])
  @@index([stageId])
}

/// Replaces the old `branches` JSON column. One row per decision taken (n-qfs, n-drying, n-xferdec).
model ReceiptBranch {
  receiptId String
  stageId   String
  branchId  String
  decidedAt DateTime @default(now())
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@id([receiptId, stageId])
}

/// Backs ReceiptRecord.timeline. `at` is a string because the seed carries bare dates
/// ("2026-02-17") while live writes carry full ISO timestamps — normalizing would rewrite
/// real imported values.
model TimelineEntry {
  id        Int     @id @default(autoincrement())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  status    String
  at        String
  note      String?
  /// Who caused this entry. NULL on every row that predates the role system — not backfilled, since
  /// naming an actor for old rows would be fabricating one.
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id])

  @@index([receiptId])
}

/// Scoped to a specific Lot/quantity, never a whole Bin (confirmed rule — a Bin mixes Lots).
/// lotNo is a soft reference: real drying history references Lots from before this system existed,
/// and the drying-job lot namespace shares zero keys with the receipts' (see header note 5).
model DryingJob {
  id           String    @id
  date         String
  warehouse    String
  warehouseRef Warehouse @relation(fields: [warehouse], references: [name])
  bin          String
  lotNo        String
  /// The lot exactly as the workbook wrote it ("17"). lotNo holds the system format
  /// (LOT-<code>-<year>-017) since the Oct 2026 ID standardisation; see contract's domain/ids.ts.
  lotNoRaw     String?
  ficheNo      String
  status       String
  dryType      String
  destination  String

  /// The confirmed drying sequence: moisture before -> issue Lot/qty -> dry -> moisture after ->
  /// return to warehouse -> store in a new Bin marked as dried stock, Lot traceability retained.
  moistureBefore   String?
  moistureAfter    String?
  quantityIssued   String?
  quantityReturned String?
  driedStockBin    String?
  /// The Lot this dried stock still traces back to, after it moves to driedStockBin.
  originLotNo      String?

  @@index([lotNo])
  @@index([bin])
  @@index([ficheNo])
  @@index([warehouse])
}

// ── Per-stage tables ──────────────────────────────────────────────────────
// GENERATED by packages/contract/scripts/gen-prisma-models.ts from stages.ts. Re-run that
// script after changing stages.ts; tests/stageMap.schema.test.ts enforces agreement.

/// Stage n-gate (entry) — Truck arrives at warehouse (Gate entry)
/// Source: ANAGROCI DATA PROCUREMENT 2026.xlsx · Truck Reception · 28 columns
model StageGateEntry {
  receiptId     String  @id
  sn            String? /// S N
  dateOfArrival String? /// DATE OF ARRIVAL
  rmFg          String? /// RM/FG
  creditCash    String? /// CREDIT/CASH
  whLocation    String? /// WH LOCATION
  whNo          String? /// WH NO.
  vehicleNo     String? /// VEHICLE NO.
  warehouseType String? /// Warehouse type (Village/Regional/Factory)
  remarks       String? /// REMARKS
  week          String? /// WEEK
  receipt       Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-verify (entry) — Verify supplier documents
/// Source: ANAGROCI DATA PROCUREMENT 2026.xlsx · Truck Reception · 28 columns
model StageVerifyDocs {
  receiptId     String  @id
  suppliersName String? /// SUPPLIERS NAME
  lbaCode       String? /// LBA CODE
  ficheCode     String? /// FICHE CODE
  ref           String? /// REF.
  fiche         String? /// FICHE
  origin        String? /// ORIGIN
  receipt       Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  /// The one identifier that actually travels with a batch across OFFLOADINGS, the drying report,
  /// and the transfer ledger (Lot and Bin don't — see DryingJob.ficheNo's comment) — backs the
  /// receipt "linked records" lookup in services/receiptLinks.ts.
  @@index([fiche])
}

/// Stage n-qfs (decision) — Quality analysis (QFS)
/// Source: ANAGROCI DATA PROCUREMENT 2026.xlsx · Truck Reception · 28 columns
model StageQualityQfs {
  receiptId         String   @id
  sampleMoisture    String? /// Sample moisture (%)
  finalMoisture     String? /// Final moisture (%)
  sampleNutCount    String? /// Sample nut count
  finalNutCount     String? /// Final nut count
  kor               String? /// KOR
  finalKor          String? /// FINAL KOR
  sampleGoodKernelG String? /// Sample – Good Kernel (g)
  sampleImmatureG   String? /// Sample – Immature (g)
  sampleSpottedG    String? /// Sample – Spotted (g)
  sampleRejectionG  String? /// Sample – Rejection (g)
  sampleVoidG       String? /// Sample – Void (g)
  sampleOilG        String? /// Sample – Oil (g)
  sampleShellG      String? /// Sample – Shell (g)
  finalGoodKernelG  String? /// Final – Good Kernel (g)
  finalImmatureG    String? /// Final – Immature (g)
  finalSpottedG     String? /// Final – Spotted (g)
  finalRejectionG   String? /// Final – Rejection (g)
  finalVoidG        String? /// Final – Void (g)
  finalOilG         String? /// Final – Oil (g)
  finalShellG       String? /// Final – Shell (g)
  finalMoistureNum  Decimal? /// typed shadow of finalMoisture, for reporting/DQ only — never round-tripped
  finalNutCountNum  Decimal? /// typed shadow of finalNutCount, for reporting/DQ only — never round-tripped
  korNum            Decimal? /// typed shadow of kor, for reporting/DQ only — never round-tripped
  finalKorNum       Decimal? /// typed shadow of finalKor, for reporting/DQ only — never round-tripped
  receipt           Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-gross (entry) — Weight truck (Gross weight)
/// Source: ANAGROCI DATA PROCUREMENT 2026.xlsx · Truck Reception · 28 columns
model StageGrossWeight {
  receiptId           String   @id
  loadedTruckWtKgs    String? /// Loaded truck weight (kg)
  tareWtKgs           String? /// Tare / empty truck weight (kg)
  grossWtKgs          String? /// GROSS WT KGS
  loadedTruckWtKgsNum Decimal? /// typed shadow of loadedTruckWtKgs, for reporting/DQ only — never round-tripped
  tareWtKgsNum        Decimal? /// typed shadow of tareWtKgs, for reporting/DQ only — never round-tripped
  grossWtKgsNum       Decimal? /// typed shadow of grossWtKgs, for reporting/DQ only — never round-tripped
  receipt             Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-lot (gap) — Assign Lot Number to truck
model StageLotAssignment {
  receiptId      String  @id
  lotNumber      String? /// Lot Number
  truckReference String? /// Truck reference
  assignedBy     String? /// Assigned by (Warehouse Team)
  assignedAt     String? /// Date/time assigned
  receipt        Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  /// NOT a stage field — no label in stages.ts maps to it, and STAGE_FIELD_MAP must never gain one.
  /// It exists only so lot uniqueness can be enforced PER WAREHOUSE by a real database constraint.
  /// Measured on the client's own sheets: the same truck is Lot 17 at Bouaké and Lot 20 at Yakro
  /// (334 of 339 fiche-matched rows disagree), so each warehouse runs its own 1..N lot sequence and
  /// a global unique index would reject the second site's Lot 1 outright. A constraint can't span
  /// the join to Receipt.warehouse, hence this controlled copy, written from Receipt.warehouse at
  /// the same moment as lotNumber and asserted equal to it by a data-quality check.
  warehouseName String?

  @@index([warehouseName, lotNumber])
}

/// Stage n-bin (gap) — Allocate Bin (physical storage location)
model StageBinAllocation {
  receiptId        String  @id
  binNumber        String? /// Bin Number
  linkedLotNumbers String? /// Linked Lot Number(s)
  allocationBasis  String? /// Basis for allocation (moisture / quality / KOR / space)
  finalisedWhen    String? /// Finalised (same day / next day)
  allocationDate   String? /// Bin allocation date
  finalisedBy      String? /// Finalised by
  receipt          Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-unload (entry) — Unload RCN at warehouse
/// Source: ANAGROCI DATA PROCUREMENT 2026.xlsx · Truck Reception · 28 columns
model StageUnload {
  receiptId          String   @id
  dateOfOffloading   String? /// DATE OF OFFLOADING
  sacs               String? /// SACS (bags)
  bonSacs            String? /// BON SACS (good bags)
  humidSacs          String? /// HUMID SACS (damp bags)
  sacsDechires       String? /// Sacs déchirés (torn bags)
  refraction         String? /// Refraction
  manpowerContractor String? /// Manpower contractor / team
  tallyClerkBagCount String? /// Tally Clerk bag count
  palletsUsed        String? /// Pallets used (30 bags/pallet)
  sacsNum            Decimal? /// typed shadow of sacs, for reporting/DQ only — never round-tripped
  bonSacsNum         Decimal? /// typed shadow of bonSacs, for reporting/DQ only — never round-tripped
  humidSacsNum       Decimal? /// typed shadow of humidSacs, for reporting/DQ only — never round-tripped
  sacsDechiresNum    Decimal? /// typed shadow of sacsDechires, for reporting/DQ only — never round-tripped
  refractionNum      Decimal? /// typed shadow of refraction, for reporting/DQ only — never round-tripped
  receipt            Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-netwt (system) — Calculate net weight
/// Source: ANAGROCI DATA PROCUREMENT 2026.xlsx · Truck Reception · 28 columns
model StageNetWeight {
  receiptId   String   @id
  netWtKgs    String? /// NET WT KGS
  paidWt      String? /// PAID WT
  netWtKgsNum Decimal? /// typed shadow of netWtKgs, for reporting/DQ only — never round-tripped
  paidWtNum   Decimal? /// typed shadow of paidWt, for reporting/DQ only — never round-tripped
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-grn (entry) — Generate RCN reception record (GRN)
/// Source: ANAGROCI DATA PROCUREMENT 2026.xlsx · Truck Reception · 28 columns
model StageGrn {
  receiptId    String   @id
  price        String? /// PRICE
  amount       String? /// AMOUNT
  grnWeight    String? /// GRN Weight (kept separate from Gross/Net/Paid)
  priceNum     Decimal? /// typed shadow of price, for reporting/DQ only — never round-tripped
  amountNum    Decimal? /// typed shadow of amount, for reporting/DQ only — never round-tripped
  grnWeightNum Decimal? /// typed shadow of grnWeight, for reporting/DQ only — never round-tripped
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-stock (system) — Add this truck to warehouse stock
model StageStockUpdate {
  receiptId           String  @id
  stockLedgerEntry    String? /// Added to stock from this truck (kg)
  warehouseType       String? /// Warehouse type (Village/Regional/Factory)
  currentStockBalance String? /// Total warehouse stock after this truck (kg)
  receipt             Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-drying (decision) — Does this truck/lot need drying?
model StageDryingDecision {
  receiptId            String  @id
  decision             String? /// Decision (Direct to drying / Warehouse → Drying)
  moistureBefore       String? /// Moisture % — before drying
  lotQtyIssued         String? /// Lot/quantity identified & issued for drying
  moistureAfter        String? /// Moisture % — after drying
  driedQtyReturned     String? /// Dried quantity returned to warehouse
  driedStockBin        String? /// New/assigned Bin (marked "dried stock")
  traceabilityRetained String? /// Original Lot/truck traceability retained
  receipt              Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-otheract (gap) — Other warehouse activities
model OtherActivity {
  id                       String  @id @default(uuid())
  receiptId                String
  seq                      Int /// order within the receipt; the assembler projects the highest seq into stageData
  rebagging                String? /// Re-bagging (damaged/torn bags)
  destacking               String? /// Destacking
  triage                   String? /// Triage (quality + quantity + moisture check)
  movementBetweenLocations String? /// Movement between locations
  linkedStockLot           String? /// Linked stock/lot
  linkedLocation           String? /// Linked location
  receipt                  Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, seq])
  @@index([receiptId])
}

/// Stage n-ledger (gap) — Activity ledger (sequence of record)
model ActivityLedgerEntry {
  id           String  @id @default(uuid())
  receiptId    String
  seq          Int /// order within the receipt; the assembler projects the highest seq into stageData
  activityType String? /// Activity type (discharge, weight, reconditioning, destacking, drying, triage, sèches)
  occurredAt   String? /// Date/time
  quantity     String? /// Quantity
  location     String? /// Location
  linkedLotBin String? /// Linked Lot/Bin
  performedBy  String? /// Performed by
  receipt      Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, seq])
  @@index([receiptId])
}

/// Stage n-xferdec (decision) — Transfer to central / factory warehouse?
model StageTransferDecision {
  receiptId String  @id
  decision  String? /// Decision (Stays / Transfers)
  drivenBy  String? /// Driven by (space at warehouse)
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-reject (gap) — Reject / Hold and inform procurement in charge
model StageRejection {
  receiptId  String  @id
  reason     String? /// Reason for rejection
  statusNote String? /// Status = Rejected (record retained)
  receipt    Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

// ── Jute bag ledgers ──────────────────────────────────────────────────────
// Four separate but linked ledgers. Every movement must trace to Warehouse -> Supplier/Department
// -> Activity -> Quantity -> Movement Type -> Responsible Person/Team -> Date, and link back to the
// Truck/Lot/RCN delivery where applicable — hence real FKs on the edges that are provably clean.
//
// The reconciliation rule (opening + receipts + transfers in − issues − damaged/discarded −
// transfers out = closing) is NOT a stored column anywhere. It is computed by the SQL views
// created in this migration; see backend/src/domain/juteBalance.ts. A stored running balance is
// precisely the drift those views exist to prevent.

/// Ledger 1 — warehouse-level stock. 298 real rows from BOUAKE WAREHOUSE JUTE BAGS MOVEMENT
/// REPORT.xlsx -> JUTE BAGS ISSUED.
model JuteWarehouseMovement {
  id       String @id @default(uuid())
  /// Dense 1..N import order. This, not `sn`, is the ordering key: the sheet's S N column has
  /// duplicates (99-108 repeat) so it cannot identify a row. An opening balance row takes a seq
  /// below 1, so it sorts first in its warehouse however late it is entered.
  seq      Int    @unique
  /// The sheet's own S N value, kept verbatim. Not unique — see `seq`.
  sn       Int?
  /// The physical row this came from in the workbook, for traceability back to the source.
  sheetRow Int?

  movementDate DateTime?
  /// The raw cell value when it wasn't a real date — the column is mixed-type (287 datetimes and
  /// 11 hand-typed DD-MM-YYYY strings). Preserved rather than coerced.
  rawDate      String?

  /// Overloaded in the source: sometimes a process category, sometimes a supplier name. Kept raw;
  /// `activityCategory` is our derived reading of it, and the overloading is reported by
  /// /api/data-quality rather than cleaned away.
  activitiesType   String
  activityCategory String?

  supplierCode String?
  supplier     Supplier? @relation(fields: [supplierCode], references: [code])

  whLocation String
  warehouse  Warehouse @relation(fields: [whLocation], references: [name])

  truckNumber  String?
  wrNo         String?
  /// Exactly one of these is set on every one of the 298 real rows.
  bagsIssued   Int?
  bagsReceived Int?

  /// The workbook's own BALANCE, stored verbatim and never written by the app. It genuinely goes
  /// negative from S N 195 down to −11,027; the view compares it against the computed running
  /// balance and reports any divergence instead of correcting either one.
  reportedBalance Int?

  /// Gap columns — no workbook captures a good/damaged/repairable split today.
  goodBagsAvailable Int?
  completelyDamaged Int?
  damagedRepairable Int?

  /// Links a bag movement back to the RCN delivery that caused it, where known.
  receiptId String?

  /// Set when this row came from the Vendor Receiving tab.
  vendorReceipt   JuteVendorReceipt?
  /// Set when this row came from the Empty Bag Receiving tab.
  emptyBagReceipt JuteEmptyBagReceipt?
  /// Set on a warehouse's opening balance row.
  openingBalance  JuteOpeningBalance?

  createdAt DateTime @default(now())

  @@index([whLocation, seq])
  @@index([supplierCode])
  @@index([receiptId])
}

/// Jute bags received from a vendor (client trial observations, 02-11-2026, point 7). The bags, date and warehouse are on
/// `movement`, so the running balance has one source; short quantity is derived (contract domain/juteVendorReceipt.ts).
model JuteVendorReceipt {
  id             String                @id @default(uuid())
  movementId     String                @unique
  movement       JuteWarehouseMovement @relation(fields: [movementId], references: [id])
  vendorName     String
  deliveryNoteNo String
  invoicedQty    Int
  remarks        String?
  createdById    String?
  createdBy      User?                 @relation("JuteVendorReceiptAuthor", fields: [createdById], references: [id])
  createdAt      DateTime              @default(now())
}

/// Empty jute bags received from another warehouse (client observations list, point 8). The bags, date, truck, receipt no. and
/// receiving warehouse are on `movement`, so the running balance has one source; this holds what that ledger has no column for.
model JuteEmptyBagReceipt {
  id               String                @id @default(uuid())
  movementId       String                @unique
  movement         JuteWarehouseMovement @relation(fields: [movementId], references: [id])
  fromWarehouse    String
  from             Warehouse             @relation(fields: [fromWarehouse], references: [name])
  responsibleParty String
  createdById      String?
  createdBy        User?                 @relation("JuteEmptyBagReceiptAuthor", fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())

  @@index([fromWarehouse])
}

/// A warehouse's opening jute bag count (client trial observations, 02-11-2026, point 7). The bags and date are on `movement`,
/// the first row of that warehouse's ledger by seq, so the running balance starts from it. One per warehouse, enforced by a
/// partial unique index on JuteWarehouseMovement (see the jute_opening_balance migration).
model JuteOpeningBalance {
  id          String                @id @default(uuid())
  movementId  String                @unique
  movement    JuteWarehouseMovement @relation(fields: [movementId], references: [id])
  remarks     String?
  createdById String?
  createdBy   User?                 @relation("JuteOpeningAuthor", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?                 @relation("JuteOpeningEditor", fields: [updatedById], references: [id])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt
}

/// Ledger 2 — supplier-level movement. Intentionally created empty: every column is a gap, and the
/// only source is an undated hand tally, so seeding rows would mean fabricating dates and
/// transaction ids. The real figures live in JuteTallySnapshot.
model JuteSupplierMovement {
  id String @id @default(uuid())

  movementDate DateTime?
  supplierCode String
  whLocation   String?

  bagsIssuedToSupplier  Int?
  returnedViaDeliveries Int?
  /// Only a balance someone typed over the calculated one; null otherwise. The balance itself is calculated (contract's supplierPendingBalances).
  pendingWithSupplier   Int?
  damaged               Int?
  reusable              Int?

  /// Traceability required by the clarification: activity, who did it, and the linked delivery.
  activity         String?
  movementType     String?
  responsibleParty String?
  receiptId        String?
  lotNo            String?
  /// The lot exactly as the workbook wrote it ("17"). lotNo holds the system format
  /// (LOT-<code>-<year>-017) since the Oct 2026 ID standardisation; see contract's domain/ids.ts.
  lotNoRaw         String?

  createdAt DateTime @default(now())

  @@index([supplierCode])
  @@index([receiptId])
}

/// Ledger 3 — factory/production tracking. Also created empty, same reason as ledger 2.
/// Production itself is out of scope; this table only tracks bags issued TO production.
model JuteProductionMovement {
  id String @id @default(uuid())

  movementDate DateTime?
  whLocation   String?
  department   String?

  issuedToProduction  Int?
  goodBagsRecovered   Int?
  completelyDamaged   Int?
  partiallyDamaged    Int?
  returnedToWarehouse Int?
  closingBalance      Int?

  activity         String?
  movementType     String?
  responsibleParty String?

  createdAt DateTime @default(now())

  @@index([whLocation])
}

/// Ledger 4 — warehouse-to-warehouse movement. 367 real rows from BOUAKE RCN RECEIVING at
/// Yamoussoukro as on 9.9.2026.xlsx -> Bouake Stock Reciving.
///
/// The sheet has 34 columns; juteBags.ts models 12 of them for the UI form. All 34 are stored here
/// so normalization doesn't silently discard 22 columns of real client data — the extra 22 are
/// import-and-report only in v1 (not round-tripped through the ledger form).
model JuteWarehouseTransferReceipt {
  id String @id @default(uuid())
  /// 1..367, no duplicates in the source — unlike ledger 1's S N.
  sn Int    @unique

  receivedDate DateTime?
  rawDate      String?
  month        String?
  dryUndry     String?
  idTransfer   String?

  truckRegistration String?
  lotNo             String?
  /// The lot exactly as the workbook wrote it ("17"). lotNo holds the system format
  /// (LOT-<code>-<year>-017) since the Oct 2026 ID standardisation; see contract's domain/ids.ts.
  lotNoRaw          String?
  lotDry            String?
  noFiche           String?
  ccaFicheNumber    String?
  binNo             String?

  damagedBags Int?
  newBagsUsed Int?
  recondition Int?

  /// Constant "BOUAKE" across all 367 rows — every transfer in the data is Bouaké -> Yamoussoukro.
  sourceWarehouse    String
  sourceWarehouseRef Warehouse @relation("TransferSource", fields: [sourceWarehouse], references: [name])
  /// The RCN's upstream supply town (MANKONO, NIAKARA, ...), NOT a warehouse. Soft reference: 7 of
  /// these are absent from the origins master, including a literal 'Not Mentiond '.
  origin             String?

  /// Where the transfer arrives. Unlike sourceWarehouse, this is never a cell value anywhere in the
  /// sheet — it's asserted only by column HEADERS ("Gross Weight (Yakro) Recived", "KOR Received
  /// (At Yakro)", "Moisture Received at YAKRO WH", ...). Nullable + never @default'd, same
  /// discipline as WarehouseAlias.provenance: a header-inferred fact is real, but it is reported as
  /// inferred (transfer_destination_inferred), not silently promoted to a stated one.
  destinationWarehouse    String?
  destinationWarehouseRef Warehouse? @relation("TransferDestination", fields: [destinationWarehouse], references: [name])
  /// "inferred" on every row today — there is no sheet variant yet where a per-row cell states it.
  destinationProvenance   String?

  bagsDispatched          Int?
  bagsReceived            Int?
  /// The real, meaningful difference column (= received − dispatched on all 367 rows; 123 negative).
  reportedDifference      Int?
  /// Empty in all 459 rows of the sheet — a template column nobody fills. Kept so its emptiness is
  /// a reportable fact rather than an assumption.
  finalBagsAfterRebagging Int?
  /// The broken twin of reportedDifference: equals −(Received Bags) on all 367 rows. Stored
  /// verbatim and flagged by the view; deliberately NOT a generated column, which would enshrine
  /// the bug, and deliberately not dropped, which would lose real data.
  reportedDiff            Int?

  laissePasserEntree     String?
  fullyLoadedTruckWeight Int?
  emptyTruckTareWeight   Int?
  grossWeightReceived    Int?
  netWeightAtArrival     Int?
  netWeightDispatched    Int?
  weightDifference       Int?

  /// Mixed-type in the source (365 floats, 1 comma-decimal string, 1 int). The *Raw twin keeps the
  /// original cell text so '44,94' isn't silently reinterpreted.
  korReceived           Decimal?
  korReceivedRaw        String?
  korDispatched         Decimal?
  korDispatchedRaw      String?
  moistureReceived      Decimal?
  moistureReceivedRaw   String?
  moistureDispatched    Decimal?
  moistureDispatchedRaw String?

  ncArrival String?
  comment   String?

  createdAt DateTime @default(now())

  @@index([sourceWarehouse, sn])
  @@index([destinationWarehouse])
  @@index([lotNo])
  @@index([binNo])
  @@index([noFiche])
}

/// Unit-warehouse OFFLOADING — sheet "DISCHARGEMENT" of Suppliers Offloading_Bouake Warehouse
/// Report.xlsx. This is where a Lot Number is actually ASSIGNED (confirmed on the Sept 2026 client
/// call: Lot, not Fiche, is what the client tracks a batch by), which makes it the one sheet that
/// carries BOTH identifiers — measured 454 rows, 454 distinct lots, zero duplicates, and every row
/// also carrying the arrival fiche. That 1:1 bridge is what lets real Lot numbers reach a Receipt
/// at all; OFFLOADINGS has no Lot column, so before this every imported receipt had none.
///
/// Stored verbatim, all 64 columns, same as JuteWarehouseTransferReceipt — the 16-stage model has
/// no home for most of them and dropping them would be fabrication by omission (ground rule §4).
/// Two quality panels, not one: columns 33-48 and 49-64 repeat the SAME 16 labels, distinguished
/// only by the row-3 banners "(Sampling Report)" and "(Final Offloading Report)" — which is why
/// the importer keys off column index and pins those banners as header anchors.
model WarehouseDischarge {
  /// Surrogate PK. `lotNo` alone used to be the PK — that broke the moment the central warehouse's
  /// own discharge-equivalent data arrived: Bouaké runs lots 1..454, Yamoussoukro runs 1..256, and
  /// EVERY ONE of the 256 central values already exists as a Bouaké lot (measured against
  /// ANAGROCI DATA PROCUREMENT 2026.xlsx's "Warehouse Receiving" sheet before writing this). A lot
  /// number is only unique together with its site — same fact StageLotAssignment's per-warehouse
  /// index already encodes — so the real key is (warehouseSite, lotNo), enforced below.
  id String @id @default(uuid())

  /// The sheet's own S. No. Not unique across sites, so not a key either.
  sn Int

  /// Required — this table's uniqueness genuinely depends on it, unlike `warehouse` below.
  warehouseSite  String
  warehouse      String?
  /// Bouaké writes a finer granularity here (BKE-003-BIN-003) than the receipts master holds
  /// (BKE-003), and 101 rows carry a third namespace entirely (DIRECT-00x). Kept verbatim and NOT
  /// written onto the receipt's n-bin stage — reconciling the three bin namespaces is its own job.
  unloadingBin   String?
  /// Filled on only 47 rows, and deliberately NOT written to the n-drying stage: n-drying presence
  /// is what deriveStatus() reads to report "in drying", so writing it would silently advance 47
  /// receipts on the strength of a bin label.
  afterDryingBin String?

  /// The sheet's own real key WITHIN one site (454/454 distinct at Bouaké) — but not globally, see
  /// the `id` comment above. Dedup on re-upload is `@@unique([warehouseSite, lotNo])`, below.
  lotNo    String
  /// The lot exactly as the workbook wrote it ("17"). lotNo holds the system format
  /// (LOT-<code>-<year>-017) since the Oct 2026 ID standardisation; see contract's domain/ids.ts.
  lotNoRaw String?

  scaleLocation String?
  whReceiptNo   String?
  /// The bridge back to a Receipt (StageVerifyDocs.fiche). Usually one number, but 2 real rows
  /// carry two slash-joined fiches ("69883/69881") — stored exactly as written, because the
  /// receipts sheet carries the same joined value and they resolve.
  ficheCca      String
  truckNo       String?

  arrivalDate      DateTime?
  dischargeDate    DateTime?
  /// Raw twins, same reason as JuteWarehouseTransferReceipt.rawDate: all 454 rows in today's file
  /// hold real dates, but a hand-typed one would otherwise vanish rather than be preserved and
  /// reported. Populated only when the cell wasn't a real date.
  arrivalDateRaw   String?
  dischargeDateRaw String?

  origin       String?
  supplierName String?
  supplierCode String?

  bonSacs      Int?
  humidSacs    Int?
  tornSacs     Int?
  reconSacs    Int?
  totalSacsLot Int?
  sacsExports  Int?
  sacsBio      Int?
  sacsBrousses Int?
  totalRecd    Int?

  grossWtRecd     Decimal?
  totalRefraction Decimal?
  grnQty          Decimal?
  weightPaid      Decimal?
  netWeight       Decimal?
  diff            Decimal?
  grnFreshQty     Decimal?
  grnDriedQty     Decimal?

  /// Quality panel 1 of 2 — row-3 banner "(Sampling Report)", columns 33-48.
  samplingBrowns             Decimal?
  samplingVoids              Decimal?
  samplingOil                Decimal?
  samplingTotDefect          Decimal?
  samplingGoodKernel         Decimal?
  samplingImmature           Decimal?
  samplingSpotted            Decimal?
  samplingTotKernels         Decimal?
  samplingKor                Decimal?
  samplingShot               Decimal?
  samplingFot                Decimal?
  samplingUsefulKernelsYield Decimal?
  samplingTotalYield         Decimal?
  samplingMoisture           Decimal?
  samplingNc                 Decimal?
  samplingShell              Decimal?

  /// Quality panel 2 of 2 — row-3 banner "(Final Offloading Report)", columns 49-64.
  finalOffloadBrowns             Decimal?
  finalOffloadVoids              Decimal?
  finalOffloadOil                Decimal?
  finalOffloadTotDefect          Decimal?
  finalOffloadGoodKernel         Decimal?
  finalOffloadImmature           Decimal?
  finalOffloadSpotted            Decimal?
  finalOffloadTotKernels         Decimal?
  finalOffloadKor                Decimal?
  finalOffloadShot               Decimal?
  finalOffloadFot                Decimal?
  finalOffloadUsefulKernelsYield Decimal?
  finalOffloadTotalYield         Decimal?
  finalOffloadMoisture           Decimal?
  finalOffloadNc                 Decimal?
  finalOffloadShell              Decimal?

  /// The physical row this came from, for traceability back to the source.
  sheetRow  Int?
  source    String?
  createdAt DateTime @default(now())

  /// ── Verbatim-only fields from a SECOND, richer source: "Warehouse Receiving" (header row 1, 83
  /// columns) in ANAGROCI DATA PROCUREMENT 2026.xlsx — measured 710 rows = 454 BOUAKE + 256
  /// YAMOUSSOUKRO, confirming this model's own comment above about the two sites' lot namespaces
  /// colliding 100%. That sheet's Bouaké rows carry the SAME (warehouseSite, lotNo) pairs already
  /// written by the DISCHARGEMENT import above, so committing it is where the composite key (see
  /// this model's header comment) earns its keep: re-importing skips the 454 Bouaké dupes via
  /// skipDuplicates and inserts only the 256 genuinely new Yamoussoukro rows. A field below is
  /// reused from the DISCHARGEMENT-derived columns above ONLY where the two sheets' own header
  /// text names the identical concept (Lot No, Fiche CCA, bag counts that are always-populated on
  /// both sheets, ...); every genuinely new column gets its own field here rather than an invented
  /// mapping onto a similarly-named-but-not-provably-identical DISCHARGEMENT column — e.g. this
  /// sheet's "good bags offloaded"/"total bags stock" are Yamoussoukro-only (256/710 non-blank) and
  /// have no DISCHARGEMENT counterpart at all, so they get new columns rather than being folded
  /// into bonSacs/totalSacsLot.
  lotDry                 String? /// "lot dry" — 28/710 non-blank
  deliveryNoteNo         String? /// "delivery note no" — distinct from whReceiptNo, 247/710 non-blank
  ficheDateRaw           String? /// "fiche date" — a hand-typed DD/MM/YYYY string, never a real Date cell; kept verbatim like every other *Raw twin here
  activity               String? /// "activity" — 13/710 non-blank
  ccakValidated          String? /// "ccak validated" — e.g. "OK", 235/710 non-blank
  storageArea            String? /// "storage area" — e.g. "B3", 96/710 non-blank
  ccaNo                  String? /// "cca no" — distinct from supplierCode, 65/710 non-blank
  goodBagsOffloaded      Int? /// "good bags offloaded" — Yamoussoukro-only, 256/710 non-blank
  damagedBagsOffloaded   Int? /// "damaged bags offloaded" — 152/710 non-blank
  totalBagsDischarged    Int? /// "total bags discharged" — Yamoussoukro-only, 256/710 non-blank
  reconditionBags        Int? /// "recondition bags" — 74/710 non-blank
  totalBagsStock         Int? /// "total bags stock" — Yamoussoukro-only, 256/710 non-blank
  newBagsUsedRecondition Int? /// "new bags used recondition" — 248/710 non-blank
  /// "recondition flag" — despite the name this holds a bag COUNT in the real sheet (matches
  /// reconditionBags/newBagsUsedRecondition in magnitude, not 0/1), stored verbatim under its own
  /// header rather than reinterpreted as a boolean.
  reconditionFlag        Int?
  /// "reconditioned bags" — a template column nobody fills: 0/710 non-blank, same situation as
  /// JuteWarehouseTransferReceipt.finalBagsAfterRebagging. Kept so its emptiness is reportable.
  reconditionedBags      Int?
  weightDifferenceKg     Decimal? /// "weight difference kg" — always populated, 710/710
  netWeightBookKg        Decimal? /// "net weight book kg" — Yamoussoukro-only, 256/710 non-blank

