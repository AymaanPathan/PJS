  bagsYakro        Int?
  grossYakro       Decimal?
  differenceWeight Decimal?

  sheetRow  Int?
  source    String?
  createdAt DateTime @default(now())

  @@unique([source, sheetRow])
  @@index([vyogeNumber])
  @@index([ficheCca])
  @@index([warehouseSite])
}

/// Consolidated Drying Batch — BOTH sites, one shape. Sheet "Drying Batch" (header row 1, 56
